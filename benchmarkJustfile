HOST_1 := "sin"
HOST_2 := "hel"
HOST_3 := "ash"

ETCD_CLIENT_PORT := "2381"

create-jar:
	#!/usr/bin/env fish
	set fish_trace 1

	cd ~/work/REScala
	sbt proBench/Universal/packageBin

	cp ~/work/REScala/Modules/Examples/Protocol\ Benchmarks/target/universal/probench.zip ~/work/benchmarks/jars/probench.zip
	rm -rf ~/work/benchmarks/client/*
	unzip ~/work/benchmarks/jars/probench.zip -d ~/work/benchmarks/client

start-etcd-cluster leader="hel":
	#!/usr/bin/env fish
	set fish_trace 1

	ssh ash "sudo systemctl start etcd-node.service"
	ssh sin "sudo systemctl start etcd-node.service"
	ssh hel "sudo systemctl start etcd-node.service"

	sleep 10

	set -lx ETCD_CLUSTER "{{HOST_1}}:2381,{{HOST_2}}:2381,{{HOST_3}}:2381"

	set -l ep_status (string split "," (etcdctl --endpoints $ETCD_CLUSTER endpoint status | grep {{leader}}))
	etcdctl --endpoints $ETCD_CLUSTER move-leader (string trim $ep_status[2])

start-pb-cluster:
	ssh sin "sudo systemctl start pb-node.service"
	sleep 1
	ssh hel "sudo systemctl start pb-node.service"
	sleep 1
	ssh ash "sudo systemctl start pb-node.service"
	sleep 1
	sleep 10

stop-etcd-cluster:
	ssh sin "sudo systemctl stop etcd-node.service"
	ssh hel "sudo systemctl stop etcd-node.service"
	ssh ash "sudo systemctl stop etcd-node.service"

stop-pb-cluster:
	ssh ash "sudo systemctl stop pb-node.service"
	ssh sin "sudo systemctl stop pb-node.service"
	ssh hel "sudo systemctl stop pb-node.service"

start-etcd-client-all:
	#!/usr/bin/env fish
	set -lx CLUSTER http://{{HOST_1}}:2381 http://{{HOST_2}}:2381 http://{{HOST_3}}:2381

	./client/probench/bin/probench etcd-client --name client_1 --endpoints $CLUSTER

start-etcd-client leader:
	#!/usr/bin/env fish
	set -lx CLUSTER http://{{leader}}:2381

	./client/probench/bin/probench etcd-client --name client_1 --endpoints $CLUSTER

start-pb-client node_name="hel":
	./client/probench/bin/probench client --name client_1 --node {{node_name}}:8010

start-pb-bench-client warmup measurement node_name="hel" mode="write":
	./client/probench/bin/probench benchmark-client-timed --mode {{mode}} --warmup {{warmup}} --measurement {{measurement}} --name client1 --node {{node_name}}:8010

start-etcd-bench-client warmup measurement node_name="hel" mode="write":
	./client/probench/bin/probench etcd-client-timed --mode {{mode}} --warmup {{warmup}} --measurement {{measurement}} --name client1 --endpoints http://{{node_name}}:2381

proto-bench iterations warmup measurement mode="write" node_name="hel" leader="hel":
	#!/usr/bin/env fish
	set fish_trace 1

	set -lx BENCH_RESULTS_DIR results
	set -lx ID (random)

	set -lx SYSTEM_ID pb

	for i in (seq {{iterations}});
		set -lx RUN_ID cluster3-{{mode}}-{{warmup}}_{{measurement}}-id{$ID}_run$i

		echo Iteration $i

		just stop-pb-cluster
		just start-pb-cluster
		just start-pb-bench-client {{warmup}} {{measurement}} {{node_name}} {{mode}}
		just stop-pb-cluster
	end

etcd-bench iterations warmup measurement mode="write" node_name="hel" leader="hel":
	#!/usr/bin/env fish
	set fish_trace 1

	set -lx BENCH_RESULTS_DIR results
	set -lx ID (random)

	set -lx SYSTEM_ID etcd

	for i in (seq {{iterations}});
		set -lx RUN_ID cluster3-{{mode}}-{{warmup}}_{{measurement}}-id{$ID}_run$i

		echo Iteration $i
		echo RUN_ID $RUN_ID

		just stop-etcd-cluster
		just start-etcd-cluster {{leader}}
		just start-etcd-bench-client {{warmup}} {{measurement}} {{node_name}} {{mode}}
		just stop-etcd-cluster
	end


proto-bench-local iterations warmup measurement mode="write":
	#!/usr/bin/env fish
	set fish_trace 1

	set -lx BENCH_RESULTS_DIR results
	set -lx ID (random)

	set -lx SYSTEM_ID pb

	for i in (seq {{iterations}});
		set -lx RUN_ID cluster3-{{mode}}-{{warmup}}_{{measurement}}-id{$ID}_run$i

		echo Iteration $i

		# start cluster
		./client/probench/bin/probench node --name NODE1 --listen-client-port 8010 --listen-peer-port 8011 --cluster --initial-cluster-ids NODE1 NODE2 NODE3 &> /dev/null &
		set -l NODE1 (jobs -pl)
		sleep 1

		./client/probench/bin/probench node --name NODE2 --listen-client-port 8020 --listen-peer-port 8021 --cluster localhost:8011 --initial-cluster-ids NODE1 NODE2 NODE3 &> /dev/null &
		set -l NODE2 (jobs -pl)
		sleep 1

		./client/probench/bin/probench  node --name NODE3 --listen-client-port 8030 --listen-peer-port 8031 --cluster localhost:8011 localhost:8021 --initial-cluster-ids NODE1 NODE2 NODE3 &> /dev/null &
		set -l NODE3 (jobs -pl)
		sleep 1

		# start client
		just start-pb-bench-client {{warmup}} {{measurement}} localhost {{mode}}
		kill $NODE1 $NODE2 $NODE3
		sleep 5
	end

etcd-bench-local iterations warmup measurement mode="write" leader="machine-1":
	#!/usr/bin/env fish
	set fish_trace 1

	set -lx BENCH_RESULTS_DIR results
	set -lx ID (random)

	set -lx SYSTEM_ID etcd

	for i in (seq {{iterations}});
		set -lx RUN_ID cluster3-{{mode}}-{{warmup}}_{{measurement}}-id{$ID}_run$i

		echo Iteration $i
		echo RUN_ID $RUN_ID

		# start etcd cluster
		set -lx TOKEN token-01
		set -lx CLUSTER_STATE new
		set -lx NAME_1 machine-1
		set -lx NAME_2 machine-2
		set -lx NAME_3 machine-3
		set -lx HOST_1 localhost
		set -lx HOST_2 localhost
		set -lx HOST_3 localhost
		set -lx CLUSTER {$NAME_1}=http://{$HOST_1}:2381,{$NAME_2}=http://{$HOST_2}:2382,{$NAME_3}=http://{$HOST_3}:2383

		rm -rf /tmp/data*.etcd

		etcd --data-dir=/tmp/data1.etcd --name {$NAME_1} --initial-advertise-peer-urls http://localhost:2381 --listen-peer-urls http://localhost:2381 --advertise-client-urls http://localhost:8010 --listen-client-urls http://localhost:8010 --initial-cluster {$CLUSTER} --initial-cluster-token token-01 &> /dev/null &
		sleep 1;
		etcd --data-dir=/tmp/data2.etcd --name {$NAME_2} --initial-advertise-peer-urls http://localhost:2382 --listen-peer-urls http://localhost:2382 --advertise-client-urls http://localhost:8020 --listen-client-urls http://localhost:8020 --initial-cluster {$CLUSTER} --initial-cluster-token token-01 &> /dev/null &
		sleep 1;
		etcd --data-dir=/tmp/data3.etcd --name {$NAME_3} --initial-advertise-peer-urls http://localhost:2383 --listen-peer-urls http://localhost:2383 --advertise-client-urls http://localhost:8030 --listen-client-urls http://localhost:8030 --initial-cluster {$CLUSTER} --initial-cluster-token token-01 &> /dev/null &
		sleep 5

		set -lx ETCD_CLUSTER "$HOST_1:2381,$HOST_2:2382,$HOST_3:2383"

		set -l ep_status (string split "," (etcdctl --endpoints $ETCD_CLUSTER endpoint status | grep 2381))
		etcdctl --endpoints $ETCD_CLUSTER move-leader (string trim $ep_status[2])

		sleep 5

		./client/probench/bin/probench etcd-client-timed --mode {{mode}} --warmup {{warmup}} --measurement {{measurement}} --name client1 --endpoints http://localhost:2381

		kill -KILL (jobs -p)
		sleep 5
	end

